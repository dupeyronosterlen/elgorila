# Páginas operativas / funnel — no indexar (refuerzo además de meta robots)
/boletos.html
  X-Robots-Tag: noindex, nofollow, noarchive
/checkout.html
  X-Robots-Tag: noindex, nofollow, noarchive
/confirmacion.html
  X-Robots-Tag: noindex, nofollow, noarchive
/compartir-boleto.html
  X-Robots-Tag: noindex, nofollow, noarchive
/encuesta.html
  X-Robots-Tag: noindex, nofollow, noarchive
/enviar-boleto.html
  X-Robots-Tag: noindex, nofollow, noarchive
/invitacion.html
  X-Robots-Tag: noindex, nofollow, noarchive
/cupon-invitado.html
  X-Robots-Tag: noindex, nofollow, noarchive
/admin.html
  X-Robots-Tag: noindex, nofollow, noarchive
/acta.html
  X-Robots-Tag: noindex, nofollow, noarchive

/css/tailwind.css
  Cache-Control: public, max-age=31536000, immutable

# Fuentes: contenido estable (se versionan con ?v=) → cache largo inmutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes de marketing: cache largo pero NO inmutable (a veces se re-optimizan in situ)
/img/*
  Cache-Control: public, max-age=2592000

# NOTA: /js/* se deja con el cache por defecto del host a propósito.
# Poner cache largo aquí arriesgaría servir scripts del funnel obsoletos
# (checkout.js, confirmacion.js, etc.) tras un deploy. No tocar sin hashing.
